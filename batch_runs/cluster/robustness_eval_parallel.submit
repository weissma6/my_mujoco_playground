#!/bin/bash
#SBATCH --job-name=ur10_robustness
#SBATCH --account=cai_iai
#SBATCH --partition=gpu
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1

set -euo pipefail

cd "$HOME/VT1_MBRL/my_mujoco_playground"
mkdir -p logs eval_outputs downloaded_policies

export WANDB__SERVICE_WAIT=180
export WANDB_API_KEY="$(< "$HOME/.secrets/wandb_key")"

source batch_runs/cluster/env_bootstrap.sh

export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export EGL_PLATFORM=surfaceless
unset DISPLAY

echo "Node: $(hostname)"
echo "GPU:  $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')"
echo "Start: $(date)"

python "${SLURM_SUBMIT_DIR}/run_robustness_eval.py"

echo "Done: $(date)"
echo "=== robustness eval completed ===" >&2
