{
  "program": "cluster/run_train.sh",
  "method": "grid",
  "metric": { "name": "eval/return", "goal": "maximize" },
  "parameters": {
    "seed": { "values": [1, 2, 3] },
    "train.lr": { "values": [0.0003, 0.0001] },
    "train.batch_size": { "values": [64, 128] }
  },
  "command": [
    "bash",
    "cluster/run_train.sh",
    "${args}"
  ]
}