#!/bin/bash
#SBATCH --job-name=UR3Pick_curriculum
#SBATCH --account=cai_iai
#SBATCH --partition=gpu
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1

set -euo pipefail

cd "$HOME/VT1_MBRL/my_mujoco_playground"
mkdir -p logs

export WANDB__SERVICE_WAIT=180
export WANDB_API_KEY="$(< "$HOME/.secrets/wandb_key")"

source batch_runs/cluster/env_bootstrap.sh

export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export EGL_PLATFORM=surfaceless
unset DISPLAY

# ONE job, five rungs walked in-process: rung N+1 warm-starts from rung N's
# weights, so there is nothing for a SLURM array to parallelise -- hence no
# --array above.
#
# --wall-budget-s is 13800 (3h50m) against a 04:00:00 --time. The driver checks
# the remaining budget before each rung after the first and stops cleanly if
# what is left is under the longest rung so far, writing _resume.json and
# exiting 0. Without that a timeout lands mid-rung, SLURM records TIMEOUT, and
# that rung's params are lost. Raise --time and this number together or not at
# all.
python batch_runs/scripts/run_curriculum_ur3.py \
  --spec batch_runs/curriculum/UR3Pick_curriculum.json \
  --out-root results \
  --wall-budget-s 13800

echo "=== curriculum ladder completed ===" >&2
