#!/bin/bash
#SBATCH --job-name=UR3Pick_sweep_uv
#SBATCH --account=cai_iai
#SBATCH --partition=gpu
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --array=1-4%2

set -euo pipefail

cd "$HOME/VT1_MBRL/my_mujoco_playground"
mkdir -p logs

export WANDB__SERVICE_WAIT=180
export WANDB_API_KEY="$(< "$HOME/.secrets/wandb_key")"

source batch_runs/cluster/env_bootstrap.sh

export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export EGL_PLATFORM=surfaceless
unset DISPLAY

# UR3Pick_sweep.jsonl is 1-indexed by the SLURM array task. Keep --array above
# in sync with the line count (currently 4 configs):
#   1 = Pick_tiny_10k_un10_env256
#   2 = Pick_tiny_5k_un10_env256
#   3 = Pick_tiny_10k_un5_env256
#   4 = Pick_tiny_10k_un20_env256
python batch_runs/scripts/run_one_ur3.py \
  --jsonl batch_runs/sweeps/UR3Pick_sweep.jsonl \
  --index "${SLURM_ARRAY_TASK_ID}" \
  --out_root results

echo "=== sweep run completed ===" >&2
