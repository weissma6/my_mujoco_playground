#!/bin/bash
#SBATCH --job-name=UR3Pick_sweep_uv
#SBATCH --account=cai_iai
#SBATCH --partition=gpu
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --array=1-2%2

set -euo pipefail

cd "$HOME/VT1_MBRL/my_mujoco_playground"
mkdir -p logs

export WANDB__SERVICE_WAIT=180
export WANDB_API_KEY="$(< "$HOME/.secrets/wandb_key")"

source batch_runs/cluster/env_bootstrap.sh

export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export EGL_PLATFORM=surfaceless
unset DISPLAY

# UR3Pick_sweep.jsonl is 1-indexed by the SLURM array task:
#   1 = Pick_un20_env2048  (UR3Pick, 20M steps, 2048 envs)
#   2 = Pick_un20_env1024  (UR3Pick, 20M steps, 1024 envs)
python batch_runs/scripts/run_one_ur3.py \
  --jsonl batch_runs/sweeps/UR3Pick_sweep.jsonl \
  --index "${SLURM_ARRAY_TASK_ID}" \
  --out_root results

echo "=== sweep run completed ===" >&2
