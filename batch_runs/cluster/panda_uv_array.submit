#!/bin/bash
#SBATCH --job-name=panda_sweep_uv
#SBATCH --account=cai_iai
#SBATCH --partition=gpu
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --array=1-4%4

set -euo pipefail

cd "$HOME/VT1_MBRL/my_mujoco_playground"
mkdir -p logs results

export WANDB__SERVICE_WAIT=180
export WANDB_API_KEY="$(< "$HOME/.secrets/wandb_key")"

source batch_runs/cluster/env_bootstrap.sh

# EGL rendering setup (headless GPU)
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export EGL_PLATFORM=surfaceless
unset DISPLAY

python batch_runs/scripts/run_one_panda.py \
  --jsonl batch_runs/sweeps/panda_sweep.jsonl \
  --index "${SLURM_ARRAY_TASK_ID}" \
  --out_root results

echo "=== panda sweep run completed ===" >&2
