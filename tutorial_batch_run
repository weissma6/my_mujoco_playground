# connect to Login node
ssh weissma6@dallas.zhaw.ch

# Step 1.3 – Go to your git repo and build with Podman on the compute node:
cd ~/VT1_MBRL/my_mujoco_playground

# Load the image tar
givemeagpushell sanfrancisco
podman load -i ~/VT1_MBRL/my_mujoco_playground/mujoco_env.tar
podman images
exit 


# step 1.2 – Weights & Biases setup – once per session
ls -l ~/.secrets/wandb_key
export WANDB_API_KEY="$(cat ~/.secrets/wandb_key)"
echo "WANDB_API_KEY is: ${WANDB_API_KEY:+SET}${WANDB_API_KEY:-MISSING}"


# step 1.3 One-time or when account changes: find your Slurm account
sacctmgr show assoc where user=weissma6 format=User,Account,Partition,QOS -P


# step 2 Edit sbatch to set the account (only when first setting up or when it changes)
nano batch_runs/slurm/run_array_panda.sbatch


# Step 3 – Submit the SLURM array job:
sbatch batch_runs/slurm/run_array_panda.sbatch
sbatch batch_runs/slurm/run_array_version_test.sbatch
sbatch batch_runs/slurm/run_array_ur10_EGLTest.sbatch

sbatch --array=3 batch_runs/slurm/run_array_ur10_EGL_final.sbatch
sbatch --array=4-5 batch_runs/slurm/run_array_ur10_EGL_final.sbatch


# ------------------------------------------------
# Step 4 Monitoring the job:
# ------------------------------------------------

# See the active jobs
squeue -u weissma6
# with remaining time
squeue -u weissma6 -o "%.18i %.9P %.20j %.8T %.10M %.10l %.6D %R"

# Track one specific job
squeue -j <job_id>

# Check job history with status
sacct -u weissma6 \
  --format=JobID,JobName%20,State,ExitCode,Elapsed \
  | grep -v '\.'

# More detailed tracking
# find the outoutfiles with the job ID from squeue
find . -maxdepth 3 -type f -name "*81840*" -print

tail -f logs/UR10_sweep_EGL_81968_4.err
tail -f logs/UR10_sweep_EGL_81968_4.out



# Stop trailing:
# Press Ctrl + C

# See detailed job info
scontrol show job <job_id>  

## Cancel job if needed
scancel <job_id>
## Canel all jobs of user
scancel -u weissma6

