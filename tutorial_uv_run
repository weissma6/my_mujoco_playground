# =====================================================================
# Run the UR3 SIMPLE-PICK training on the ZHAW cluster (uv pipeline)
# =====================================================================
# Env: UR3Pick (simple pick — lift a tilted 4cm box to a point above it).
#   The sibling pick-and-place env is UR3PicknPlace (separate sweep/sbatch).
# Pipeline pieces (all UR3 siblings of the UR10 uv files):
#   sweep   : batch_runs/sweeps/UR3Pick_sweep.jsonl   (1-indexed configs)
#   runner  : batch_runs/scripts/run_one_ur3.py       (env-agnostic, dispatches on env_name)
#   submit  : batch_runs/cluster/ur3_jsonl_array.submit
#   bootstrap: batch_runs/cluster/env_bootstrap.sh    (uv venv + jax[cuda12])
# Sweep lines:  1=Pick_un20_env2048  2=Pick_un20_env1024
#   (both UR3Pick, 20M steps, lr 8e-4, unroll 20, init_keyframe=low_home;
#    they differ ONLY in num_envs 2048 vs 1024 — a throughput comparison.)
#
# (Alternative Podman/EGL pipeline for simple pick lives at
#  batch_runs/slurm/run_array_ur3_simplepick.sbatch;
#  the pick-and-place Podman job is batch_runs/slurm/run_array_ur3.sbatch.)

# connect to Login node
ssh weissma6@dallas.zhaw.ch
cd ~/VT1_MBRL/my_mujoco_playground


# ------------------------------------------------
# Step 1 (Strongly recommended) Pre-warm the UV environment once
# ------------------------------------------------
# Avoids array jobs racing to install packages. Run once on a GPU shell.
# env_bootstrap.sh creates/activates the uv venv (default name mujoco_env_egl,
# override with VENV=...), installs requirements.txt, and reinstalls jax[cuda12].
givemeagpushell sanfrancisco
source batch_runs/cluster/env_bootstrap.sh
python -c "import mujoco, wandb, jax; print('env OK; jax devices:', jax.devices())"
# Confirm the UR3 env registers and has the expected dims (7D action, 26D obs):
python -c "from mujoco_playground import registry; e=registry.load('UR3Pick'); print('UR3Pick', e.action_size, e.observation_size)"

# ------------------------------------------------
# Step 2  Run ONE config interactively (no SLURM) on the GPU shell
# ------------------------------------------------
# Runs line 1 of the sweep (Pick_un20_env2048) directly. NOTE: this is the
# full 20M-step / 2048-env run (long) — there is no smoke config in the sweep.
# Ctrl-C to stop early; for a quick "does it load" check use the Step 1 import.
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl EGL_PLATFORM=surfaceless
export WANDB_API_KEY="$(< "$HOME/.secrets/wandb_key")"
python batch_runs/scripts/run_one_ur3.py \
  --jsonl batch_runs/sweeps/UR3Pick_sweep.jsonl \
  --index 1 \
  --out_root results

# ------------------------------------------------
# Step 3  Submit via SLURM
# ------------------------------------------------
# Single config (array index = sweep line):
sbatch --array=1-1 batch_runs/cluster/ur3_jsonl_array.submit   # Pick_un20_env2048
sbatch --array=2-2 batch_runs/cluster/ur3_jsonl_array.submit   # Pick_un20_env1024

# Full sweep (both configs, max 2 at a time):
sbatch batch_runs/cluster/ur3_jsonl_array.submit               # array 1-2%2

# See the active jobs
squeue -u weissma6
squeue -u weissma6 -o "%.18i %.9P %.20j %.8T %.10M %.10l %.6D %R"
squeue -j <job_id>

# Check job history with status
sacct -u weissma6 \
  --format=JobID,JobName%20,State,ExitCode,Elapsed \
  | grep -v '\.'

# Logs (job-name is UR3Pick_sweep_uv -> logs/UR3Pick_sweep_uv_<jobid>_<arrayidx>.{out,err})
find . -maxdepth 3 -type f -name "*UR3Pick_sweep_uv*" -print
tail -f logs/UR3Pick_sweep_uv_23307_1.err

# Watch resource usage (CPU / GPU)
sstat -j <job_id>_1.batch --format=AveCPU,AveRSS,MaxRSS,MaxVMSize,AveDiskRead,AveDiskWrite
srun --jobid <job_id>_1 -n 1 nvidia-smi
# Stop trailing: Press Ctrl + C

# See detailed job info
scontrol show job <job_id>

## Cancel job if needed
scancel <job_id>
## Cancel all jobs of user
scancel -u weissma6

#### -----------------------
# Sanity checks
#### -----------------------
# Sweep file exists and has 2 configs
ls -lh batch_runs/sweeps/UR3Pick_sweep.jsonl
wc -l batch_runs/sweeps/UR3Pick_sweep.jsonl

# Trained policy artifact is uploaded to W&B project "UR3_pick_ppo".
# Local outputs land in results/<run_id>/ (e.g. results/Pick_un20_env2048/).
ls -lh results/Pick_un20_env2048/ 2>/dev/null
