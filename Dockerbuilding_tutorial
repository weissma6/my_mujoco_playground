# How to build a docker image on the cluster directly
Change path in submitfile and conf Folder all files -> dongtten to weissma or so

# connect to Login node
ssh weissma6@dallas.zhaw.ch

# Step 2 – From the VSCode terminal, hop to a compute node
Login nodes are not for heavy work (builds, big training, etc.)
givemeagpushell sanfrancisco

# Step 3 – Go to your git repo and build with Podman on the compute node:
cd ~/VT1_MBRL/my_mujoco_playground

## Make sure Dockerfile & requirements.txt are here
ls Dockerfile requirements.txt

## Build the image
podman build -t mujoco:env .

# Check the image
podman images



# Step 4 – RUN the image with your local code mounted

#check Job Queue and cancel job
squeue -u weissma6
scancel -u weissma6

# first cd into pyfile directory
cd ~/VT1_MBRL/my_mujoco_playground

# mount the GitHUB code on the image
podman run --rm -it \
  -v $(pwd):/workspace \
  -w /workspace \
  mujoco:env \
  python learning/notebooks/panda_test.py

# Step 5 – (Recommended) Save the image to a tar on shared storage
cd ~/VT1_MBRL/my_mujoco_playground
podman save -o mujoco_env.tar mujoco:env


# RUN code later with the image
Later, on any node (or in any job script):

podman load -i ~/VT1_MBRL/my_mujoco_playground/mujoco_env.tar
podman run --rm -it \
  -v ~/VT1_MBRL/my_mujoco_playground:/workspace \
  -w /workspace \
  mujoco:env \
  python learning/notebooks/panda_test.py


# See your jobs (IDs in 1st column)
squeue -u $USER -o "%.18i %.20j %.8T %.10M %.10l %N %R"

# Kill one job
scancel <JOBID>

# Kill all your jobs
scancel -u $USER

# Kill only PENDING jobs
scancel -u $USER -t PENDING

# Kill by name (pattern)
scancel -u $USER -n run_dummy_py_script*