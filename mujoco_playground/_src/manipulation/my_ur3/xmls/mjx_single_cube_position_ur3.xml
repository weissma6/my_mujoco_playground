<mujoco model="ur3e single cube">

  <!-- Include the scene setup (robot + floor + cameras + materials) -->
  <include file="mjx_scene_position_ur3.xml"/>

  <worldbody>
    <!-- Box to pick (UR3 has shorter reach than UR10: pulled in from 0.7 m to 0.3 m) -->
    <body name="box" pos="0.3 0 0.02">
      <freejoint/>
      <geom type="box" name="box" size="0.02 0.02 0.02" condim="4"
            friction="1 .03 .003" rgba="0 1 0 1"
            contype="1" conaffinity="3" solref="0.005 1"/>
    </body>

    <!-- Mocap target (lift-point visualization; pose set per-episode by reset).
         Sphere r=0.04 fully contains the 4 cm cube (corner radius 0.0346) so a
         lifted box visibly sits inside it; visual only. -->
    <body mocap="true" name="mocap_target">
      <geom type="sphere" size="0.04" rgba="1 0 0 0.2" contype="0" conaffinity="0"/>
    </body>

    <!-- Variable-height "lifter" plate (40x40 cm, 5 mm; red so it's visible in
         rollout videos). A mocap body (zero DOF, kinematic) so its height can be
         set per-episode by reset(); the box rests on its top. reset() pins its XY
         at the nominal box pos (0.3, 0) so the 40 cm plate covers the whole box
         spawn region yet keeps its near edge 10 cm off the base (no base overlap).
         contype=2/conaffinity=3 collides the box+robot but is a distinct category
         from box/floor. It MUST stay AFTER mocap_target so the target keeps mocapid
         0 (the deployment render writes mocap_pos[0]). Default pose keeps it flat
         on the floor for un-reset (deploy) renders. -->
    <body mocap="true" name="lifter" pos="0.3 0 0.0025">
      <geom type="box" name="lifter" size="0.20 0.20 0.0025"
            contype="2" conaffinity="3" friction="1 .03 .003" rgba="0.8 0.6 1 1"/>
    </body>
  </worldbody>

  <!-- Keyframes (15 qpos = 6 arm + 2 finger + 7 box freejoint; 7 ctrl = 6 arm + 1 gripper) -->
  <keyframe>
    <key name="task_home"
      qpos="0 -2.0 1.6 -1.6 -1.5 0 0.0125 0.0125
            0.4 0 0.02
            1 0 0 0"
      ctrl="0 -2.0 1.6 -1.6 -1.5 0  0.025"/>

    <key name="low_home"
      qpos="0 -1.7 2.25 -2.15 -1.5 -1.5  0 0
            0.3 0 0.02
            1 0 0 0"
      ctrl="0 -1.7 2.25 -2.15 -1.5 -1.5  0"/>

    <key name="tucked"
      qpos="0 -2.36 2.36 -1.57 -1.57 0  0 0
            0.3 0 0.02
            1 0 0 0"
      ctrl="0 -2.36 2.36 -1.57 -1.57 0  0"/>
  </keyframe>

  <include file="ur3_pick_sensor.xml"/>

</mujoco>
