<mujoco model="ur3e scene">
  <include file="../universal_robots_ur3e/ur3e_position.xml"/>

  <worldbody>
    <!-- World coordinate frame visualization -->
    <geom name="world_x_axis" type="capsule" size="0.01 0.5" pos="0.5 0 0"
          quat="0.7071 0 0.7071 0" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    <geom name="world_y_axis" type="capsule" size="0.01 0.5" pos="0 0.5 0"
          quat="0.7071 -0.7071 0 0" rgba="0 1 0 1" contype="0" conaffinity="0"/>
    <geom name="world_z_axis" type="capsule" size="0.01 0.5" pos="0 0 0.5"
          rgba="0 0 1 1" contype="0" conaffinity="0"/>

    <!-- Floor and lighting -->
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" contype="1" conaffinity="3" solref="0.001 1"/>

    <!-- Cameras (UR3 has shorter reach than UR10: pulled in) -->
    <camera name="front" fovy="42" pos="0.85 0.001 0.4" xyaxes="0.006 1.000 -0.000 -0.720 0.004 0.694"/>

    <body name="camera_target" pos="0.3 0 0.1">
      <geom type="sphere" size="0.005" rgba="1 0 0 0" contype="0" conaffinity="0"/>
    </body>
    <camera name="side_130" pos="0.6 -0.8 0.9" mode="targetbody" target="camera_target" fovy="70"/>
    <camera name="box_detail" pos="0.6 -0.8 0.6" mode="targetbody" target="camera_target" fovy="35"/>
  </worldbody>

  <statistic center="0.3 0 0.1" extent="0.8"/>

  <option timestep="0.005" iterations="12" ls_iterations="12"
          integrator="implicitfast">
    <flag eulerdamp="disable"/>
  </option>

  <custom>
    <!-- MJX keeps the deepest N contacts per condim group; a cube gripped on the table is 4+4+4 = 12 condim-4 contacts, exactly the old cap, so 24 gives headroom. -->
    <numeric data="24" name="max_contact_points"/>
  </custom>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="-40" elevation="-30" offwidth="960" offheight="720"/>
    <map force="0.01"/>
    <quality shadowsize="8192"/>
    <scale contactwidth="0.075" contactheight="0.025" forcewidth="0.05" com="0.05" framewidth="0.01" framelength="0.2"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.4 0.5 0.6" width="800" height="800"/>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.8 0.9 1" rgb2="0.4 0.5 0.6" width="512" height="512" mark="edge" markrgb="0.2 0.2 0.2"/>
    <material name="groundplane" texture="grid" texrepeat="5 5" texuniform="true" reflectance="0.2"/>
  </asset>
</mujoco>
