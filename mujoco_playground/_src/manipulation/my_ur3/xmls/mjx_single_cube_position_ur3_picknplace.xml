<mujoco model="ur3e single cube">

  <!-- Include the scene setup (robot + floor + cameras + materials) -->
  <include file="mjx_scene_position_ur3.xml"/>

  <worldbody>
    <!-- Box to pick (UR3 has shorter reach than UR10: pulled in from 0.7 m to 0.3 m) -->
    <body name="box" pos="0.3 0 0.02">
      <freejoint/>
      <geom type="box" name="box" size="0.02 0.02 0.02" condim="4"
            friction="1 .03 .003" rgba="0 1 0 1"
            contype="1" conaffinity="3" solref="0.01 1"/>
    </body>

    <!-- Mocap target: 5 cm box the 4 cm cube must be positioned inside; pose set per-episode by reset -->
    <body mocap="true" name="mocap_target">
      <geom type="box" name="mocap_target_geom" size="0.025 0.025 0.025" rgba="1 0 0 0.2" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- Keyframes (15 qpos = 6 arm + 2 finger + 7 box freejoint; 7 ctrl = 6 arm + 1 gripper) -->
  <keyframe>
    <key name="task_home"
      qpos="0 -2.0 1.6 -1.6 -1.5 0 0.025 0.025
            0.3 0 0.02
            1 0 0 0"
      ctrl="0 -2.0 1.6 -1.6 -1.5 0  0.025"/>

    <key name="low_home"
      qpos="0 -1.7 2.25 -2.15 -1.5 -1.5  0 0
            0.3 0 0.02
            1 0 0 0"
      ctrl="0 -1.7 2.25 -2.15 -1.5 -1.5  0"/>

    <key name="tucked"
      qpos="0 -2.36 2.36 -1.57 -1.57 0  0 0
            0.3 0 0.02
            1 0 0 0"
      ctrl="0 -2.36 2.36 -1.57 -1.57 0  0"/>
  </keyframe>

  <include file="ur3_pick_sensor.xml"/>

</mujoco>
