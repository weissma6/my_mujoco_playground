<mujoco model="ur3e">
  <compiler angle="radian" eulerseq="xyz" meshdir="../universal_robots_ur3e/assets" autolimits="true"/>
  <option integrator="implicitfast"/>

  <!-- Default settings -->
  <default>
    <default class="ur3e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <general gaintype="fixed" biastype="affine" ctrlrange="-6.2831 6.2831"/>

      <default class="size2">
        <general gainprm="1000" biasprm="0 -1000 -200" forcerange="-56 56"/>
      </default>
      <default class="size1">
        <default class="size1_limited">
          <joint range="-3.14159 3.14159"/>
          <general gainprm="500" biasprm="0 -500 -100" ctrlrange="-3.14159 3.14159" forcerange="-28 28"/>
        </default>
      </default>
      <default class="size0">
        <general gainprm="200" biasprm="0 -200 -40" forcerange="-12 12"/>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="3"/>
      </default>
      <default class="eef_collision">
        <geom type="capsule" group="3"/>
      </default>
      <default class="hande_collision">
        <geom type="mesh" group="3" rgba="0.7 0.7 0.7 1"/>
      </default>

      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <default class="hande">
      <default class="hande_right_finger">
        <joint type="slide" range="0 0.025" actuatorfrcrange="-100 100" damping="15" armature="0.02" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="hande_left_finger">
        <joint type="slide" range="0 0.025" actuatorfrcrange="-100 100" damping="15" armature="0.02" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
    </default>
  </default>

  <asset>
    <material class="ur3e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur3e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur3e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur3e" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <!-- UR3 meshes -->
    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>

    <!-- Robotiq Hand-E meshes -->
    <mesh name="hande" file="hande.stl"/>
    <mesh name="coupler" file="coupler.stl"/>
    <mesh name="left_finger" file="finger_2.stl"/>
    <mesh name="right_finger" file="finger_1.stl"/>
    <mesh name="hande_col" file="hande-collision.stl"/>
    <mesh name="hande_col_right" file="finger_1-collision.stl"/>
    <mesh name="hande_col_left" file="finger_2-collision.stl"/>
  </asset>

  <!-- ================= UR3 Kinematic Chain ================= -->
  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="wrist_3_link" pos="0 -1 2"/>

    <body name="base" childclass="ur3e">
      <inertial mass="2" pos="0 0 0" diaginertia="0.0030532 0.0030532 0.005625"/>
      <geom mesh="base_0" material="jointgray" class="visual"/>
      <geom mesh="base_1" material="black" class="visual"/>

      <body name="shoulder_link" pos="0 0 0.152">
        <inertial mass="2" pos="0 0 0" diaginertia="0.00809316 0.00809316 0.005625"/>
        <joint name="shoulder_pan_joint" class="size2" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="urblue" class="visual"/>
        <geom mesh="shoulder_1" material="black" class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>
        <geom class="collision" size="0.047 0.05" pos="0 0 -0.032"/>

        <body name="upper_arm_link" pos="0 0.12 0" quat="1 0 1 0">
          <inertial mass="3.42" pos="0 0 0.122" diaginertia="0.0217285 0.0217285 0.00961875"/>
          <joint name="shoulder_lift_joint" class="size2"/>
          <geom mesh="upperarm_0" material="black" class="visual"/>
          <geom mesh="upperarm_1" material="urblue" class="visual"/>
          <geom mesh="upperarm_2" material="jointgray" class="visual"/>
          <geom mesh="upperarm_3" material="linkgray" class="visual"/>
          <geom class="collision" size="0.046 0.06" pos="0 -0.04 0" quat="1 1 0 0"/>
          <geom class="collision" size="0.038 0.11" pos="0 0 0.12"/>

          <body name="forearm_link" pos="0 -0.093 0.244">
            <inertial mass="1.26" pos="0 0 0.10625" diaginertia="0.00654457 0.00654457 0.00354375"/>
            <joint name="elbow_joint" class="size1_limited"/>
            <geom mesh="forearm_0" material="urblue" class="visual"/>
            <geom mesh="forearm_1" material="linkgray" class="visual"/>
            <geom mesh="forearm_2" material="black" class="visual"/>
            <geom mesh="forearm_3" material="jointgray" class="visual"/>
            <geom class="collision" size="0.038 0.048" pos="0 0.062 0" quat="1 1 0 0"/>
            <geom class="collision" size="0.032 0.103" pos="0 0 0.11"/>

            <body name="wrist_1_link" pos="0.0005 0 0.2125" quat="1 0 1 0">
              <inertial mass="0.8" pos="0 0.104 0" diaginertia="0.00225 0.002085 0.002085"/>
              <joint name="wrist_1_joint" class="size0"/>
              <geom mesh="wrist1_0" material="jointgray" class="visual"/>
              <geom mesh="wrist1_1" material="urblue" class="visual"/>
              <geom mesh="wrist1_2" material="black" class="visual"/>
              <geom class="collision" size="0.032 0.05" pos="0 0.045 0" quat="1 1 0 0"/>

              <body name="wrist_2_link" pos="0 0.104 0">
                <inertial mass="0.8" pos="0 0 0.085" diaginertia="0.00225 0.002085 0.002085"/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size0"/>
                <geom mesh="wrist2_0" material="jointgray" class="visual"/>
                <geom mesh="wrist2_1" material="black" class="visual"/>
                <geom mesh="wrist2_2" material="urblue" class="visual"/>
                <geom class="collision" size="0.032 0.05" pos="0 0 0.035"/>
                <geom class="collision" size="0.032 0.05" pos="0 0.025 0.085" quat="1 1 0 0"/>

                <body name="wrist_3_link" pos="0 0 0.085">
                  <inertial mass="0.35" pos="0 0.0715 0" quat="1 0 0 1" diaginertia="0.0001792 0.000136267 0.000136267"/>
                  <joint name="wrist_3_joint" class="size0"/>
                  <geom mesh="wrist3" material="linkgray" class="visual"/>
                  <geom name="attachment_site_collision" class="eef_collision" pos="0 0.132 0" quat="1 1 0 0" size="0.04 0.032"/>
                  <site name="attachment_site" pos="0 0.09215 0" quat="-1 1 0 0"/>

                  <!-- ================= Hand-E Integration ================= -->
                  <body name="robotiq_hande_mount" pos="0 0.09215 0" quat="-1 1 0 0">

                    <!-- Main hand body -->
                    <geom name="hande_coupler" mesh="coupler" class="visual" rgba="0.1 0.1 0.1 1"/>
                    <geom name="hand_base" mesh="hande" class="visual" rgba="0.1 0.1 0.1 1"/>
                    <!-- tcp is the distance position for the gripper to box -->
                    <site name="tcp" pos="0 0 0.145" rgba="0 1 0 1" size="0.002" group="2"/>t

                    <!-- Left finger -->
                    <body name="hande_left_finger" pos="0 0 0.099">
                      <inertial pos="0.02262 -0.00759 0.00738"
                                quat="0.871952 0.0369732 -0.211073 0.440205"
                                mass="0.03804"
                                diaginertia="1.22763e-05 1.22763e-05 1.22763e-05"/>
                      <joint name="hande_left_finger_joint" class="hande_left_finger" axis="1 0 0"/>
                      <geom name="left_finger" mesh="left_finger" class="visual" rgba="0.4 0.4 0.4 1"/>
                      <geom name="left_finger_collision"
                            type="box" size="0.0055 0.011 0.025" pos="-0.0305 0 0.023" rgba="0 1 0 0.3"
                            contype="1" conaffinity="1" group="3"
                            solref="0.005 1"
                            solimp="0.99 0.995 0.001 0.5 2"
                            friction="2.0 0.005 0.001"/>
                      <site name="left_finger_touch_site" pos="-0.025 0 0.04" size="0.002" rgba="1 0 0 1" group="2"/>
                    </body>

                    <!-- Right finger -->
                    <body name="hande_right_finger" pos="0 0 0.099">
                      <inertial pos="-0.02262 0.00759 0.00738"
                                quat="0.871952 -0.0369732 0.211073 0.440205"
                                mass="0.03804"
                                diaginertia="1.22763e-05 1.22763e-05 1.22763e-05"/>
                      <joint name="hande_right_finger_joint" class="hande_right_finger" axis="-1 0 0"/>
                      <geom name="right_finger" mesh="right_finger" class="visual" rgba="0.4 0.4 0.4 1"/>
                      <geom name="right_finger_collision"
                            type="box" size="0.0056 0.012 0.025" pos="0.0305 0 0.023" rgba="0 1 0 0.3"
                            contype="1" conaffinity="1" group="3"
                            solref="0.005 1"
                            solimp="0.99 0.995 0.001 0.5 2"
                            friction="2.0 0.005 0.001"/>
                      <site name="right_finger_touch_site" pos="0.025 0 0.04" size="0.002" rgba="1 0 0 1" group="2"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- ================= Hand-E Mechanics ================= -->
  <contact>
    <exclude body1="robotiq_hande_mount" body2="hande_left_finger"/>
    <exclude body1="robotiq_hande_mount" body2="hande_right_finger"/>
    <exclude body1="wrist_3_link" body2="hande_left_finger"/>
    <exclude body1="wrist_3_link" body2="hande_right_finger"/>
  </contact>

  <equality>
    <joint joint1="hande_left_finger_joint" joint2="hande_right_finger_joint"
           polycoef="0 1 0 0 0"
           solref="0.008 1"
           solimp="0.95 0.99 0.001"/>
  </equality>

  <tendon>
    <fixed name="split">
      <joint joint="hande_left_finger_joint" coef="0.5"/>
      <joint joint="hande_right_finger_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <actuator>
    <!-- Arm actuators -->
    <general class="size2" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <general class="size2" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="size1_limited" name="elbow" joint="elbow_joint"/>
    <general class="size0" name="wrist_1" joint="wrist_1_joint"/>
    <general class="size0" name="wrist_2" joint="wrist_2_joint"/>
    <general class="size0" name="wrist_3" joint="wrist_3_joint"/>

    <!-- Hand-E tendon actuator -->
    <position name="hande_fingers_actuator"
        ctrlrange="0 0.05"
        tendon="split"
        kp="400"
        kv="1"
        forcerange="-130 130"
        ctrllimited="true"
        forcelimited="true"/>
  </actuator>

  <keyframe>
    <key name="home"
      qpos="0 -2.0 2.0 -1.7 -1.5 0 0 0"
      ctrl="0 -2.0 2.0 -1.7 -1.5 0 0"/>

    <key name="vertical_home"
      qpos="0 -1.5708 0 -1.5708 0 0 0.025 0.025"
      ctrl="0 -1.5708 0 -1.5708 0 0 0.05"/>
  </keyframe>
</mujoco>
