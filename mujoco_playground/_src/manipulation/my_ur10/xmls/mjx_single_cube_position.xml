<mujoco model="ur10e single cube">

  <!-- Include the scene setup - Robot file is in Scene -->
  <include file="mjx_scene_position.xml"/>

  <worldbody>
    <!-- Box to pick -->
    <body name="box" pos="0.75 0 0.03">
      <freejoint/>
      <geom type="box" name="box" size="0.015 0.015 0.025" condim="3"
       friction="1 .03 .003" rgba="0 1 0 1" contype="1" conaffinity="3" solref="0.01 1"/>
    </body>

    <!-- mocap target -->
    <body mocap="true" name="mocap_target">
      <geom type="box" size="0.02 0.02 0.025" rgba="1 0 0 0.2" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- Keyframes -->
  <keyframe>
    <!-- Task-specific home: includes cube position -->
    <key name="task_home"
      qpos="0.75 -2.2 1.57 -1.57 -1.57 0 0 0
      0.75 0 0.025
      1 0 0 0"
      ctrl="0.75 -2.2 1.57 -1.57 -1.57 0 0"/>
    
    <!-- Low home position from camera file -->
    <key name="low_home"
      qpos="0 -1.26 1.57 -1.95 -1.5 -1.5 0 0 
      0.75 0. 0.025 
      1 0 0 0"
      ctrl="0 -1.26 1.57 -1.95 -1.5 -1.5 0"/>
    
    <!-- Picked position from camera file -->
    <key name="picked"
      qpos="0.0481 0.5604 -0.0417 -1.8459 0.0342 2.3654 0.02 0.02 0.6368 0.0064 0.1179 1.0000 0.0001 -0.0010 -0.0063"
      ctrl="0.0481 0.5604 -0.0417 -1.8459 0.0342 2.3654 0.00"/>
    
    <!-- Pre-grasp position -->
    <key name="pickup"
      qpos="-1.5 -1.7 1.8 -1.4 -1.5 0 0 0 0.35 0 0.025 1 0 0 0"
      ctrl="-1.5 -1.7 1.8 -1.4 -1.5 0 0"/>
  </keyframe>

  <!-- Optional sensors -->
  <include file="ur10_sensor.xml"/>

</mujoco>
