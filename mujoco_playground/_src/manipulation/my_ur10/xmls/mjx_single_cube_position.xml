<mujoco model="ur10e single cube">

  <!-- Include the scene setup - Robot file is in Scene -->
  <include file="mjx_scene_position.xml"/>

  <worldbody>
    <!-- Box to pick -->
    <body name="box" pos="1.0 0 0.03">
      <freejoint/>
      <geom type="box" name="box" size="0.015 0.015 0.025" condim="3"
       friction="1 .03 .003" rgba="0 1 0 1" contype="1" conaffinity="1" solref="0.01 1"/>
    </body>

    <!-- mocap target -->
    <body mocap="true" name="mocap_target">
      <geom type="box" size="0.02 0.02 0.025" rgba="1 0 0 0.2" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  

  <!-- Keyframes -->
  <keyframe>
    <!-- Task-specific home: includes cube position -->
    <key name="task_home"
      qpos="0.75 -2.2 1.57 -1.57 -1.57 0 0 0
      0.75 0 0.025
      1 0 0 0"
      ctrl="0.75 -2.2 1.57 -1.57 -1.57 0 0"/>
    
    <!-- Low home position from camera file -->
    <key name="low_home"
      qpos="0 -1.26 1.57 -1.95 -1.5 -1.5 0 0 
      0.75 0.2 0.025 
      1 0 0 0"
      ctrl="0 -1.26 1.57 -1.95 -1.5 -1.5 0"/>
    
    <!-- Picked position from camera file -->
    <key name="tucked"
      qpos="0 -2.3562 2.3562 -1.5708 -1.5708 0 0 0
      0.75 0 0.025 
      1 0 0 0"
      ctrl="0 -2.3562 2.3562 -1.5708 -1.5708 0 0"/>
    
    <!-- Pre-grasp position -->
    <key name="pickup"
      qpos="0 -1.7 1.8 -1.4 -1.5 0 0 0
       0.75 0.2 0.025 
       1 0 0 0"
      ctrl="0 -1.7 1.8 -1.4 -1.5 0 0"/>
  </keyframe>

  <!-- Optional sensors -->
  <include file="ur10_sensor.xml"/>

</mujoco>
