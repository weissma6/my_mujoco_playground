<mujoco>
<!-- Called on in mjx_single_cube.xml, before </mujoco> -->
  <sensor>
    <!-- ========== Touch/Contact Sensors ========== -->
    <!-- Use your collision geoms; rename if yours differ -->
    <touch name="left_finger_touch"  site="left_finger_touch_site"/>
    <touch name="right_finger_touch" site="right_finger_touch_site"/>
    
    <!-- Detect gripper-floor collision -->
    <touch name="gripper_floor_contact" site="tcp"/>
    
    <!-- ========== Force Sensors ========== -->
    <!-- Measure forces at gripper -->
    <force name="gripper_force" site="tcp"/>
    
    <!-- ========== Position Sensors ========== -->
    <!-- Track end-effector position -->
    <framepos name="tcp_position" objtype="site" objname="tcp"/>
    <framepos name="box_position" objtype="body" objname="box"/>

  </sensor>
</mujoco>
